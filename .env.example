# ─── Jira Cloud credentials ────────────────────────────────────────────────
# Your Atlassian domain, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=https://yourcompany.atlassian.net

# The email address associated with your Jira account
JIRA_EMAIL=your-email@company.com

# Jira API token – generate one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token

# ─── Flask server ───────────────────────────────────────────────────────────
PORT=5000

# ─── Moveworks (optional – for verifying inbound webhook signatures) ────────
# MOVEWORKS_WEBHOOK_SECRET=your-moveworks-webhook-secret
